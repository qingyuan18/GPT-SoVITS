   "source": [
    "## 2. 配置参数"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "⚠️ 请确保在运行前配置好以下参数:\n",
      "- COMFYUI_SERVER_URL\n",
      "- COMFYUI_WORKFLOW_PATH\n",
